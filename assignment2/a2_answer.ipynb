   "metadata": {},
   "source": [
    "## Imports and loading data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 63,
   "id": "376bf05d",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from sklearn.metrics import confusion_matrix\n",
    "import keras\n",
    "from keras import layers"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 64,
   "id": "213b7a25",
   "metadata": {},
   "outputs": [],
   "source": [
    "def scale_type(split):\n",
    "    return split.astype(np.float32) / 255.0\n",
    "\n",
    "def flatten(split):\n",
    "    return split.reshape(-1, 28 * 28)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 65,
   "id": "3fa49c9c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "(60000, 784) (60000,)\n"
     ]
    }
   ],
   "source": [
    "np.random.seed(1606009)\n",
    "\n",
    "# Load dataset\n",
    "(X_train, y_train), (X_test, y_test) = keras.datasets.mnist.load_data()\n",
    "\n",
    "X_train = scale_type(X_train)\n",
    "X_test = scale_type(X_test)\n",
    "\n",
    "X_train_flat = flatten(X_train)\n",
    "X_test_flat = flatten(X_test)\n",
    "\n",
    "print(X_train_flat.shape, y_train.shape)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 66,
   "id": "164f9c86",
   "metadata": {},
   "outputs": [],
   "source": [
    "def include_first(split, val_samples=10000):\n",
    "    return split[:val_samples]\n",
    "\n",
    "def exclude_first(split, val_samples=10000):\n",
    "    return split[val_samples:]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 67,
   "id": "248c9489",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Train: 50000  Val: 10000  Test: 10000\n"
     ]
    }
   ],
   "source": [
    "# Splitting validation\n",
    "x_val = include_first(X_train_flat)\n",
    "y_val = include_first(y_train)\n",
    "X_train_flat = exclude_first(X_train_flat)\n",
    "y_train = exclude_first(y_train)\n",
    "\n",
    "print(\"Train:\", X_train_flat.shape[0], \" Val:\", x_val.shape[0], \" Test:\", X_test_flat.shape[0])"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "71d39fb3",
   "metadata": {},
   "source": [
    "## Building the model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 68,
   "id": "76a0dae8",
   "metadata": {},
   "outputs": [],
   "source": [
    "def build_model(use_dropout=False, dropout_rate=0.4, num_classes=10):\n",
    "    model = keras.Sequential([\n",
    "        layers.Input((784,)),                   # Shape of the layer\n",
    "        layers.Dense(128, activation=\"relu\"),   \n",
    "        layers.Dense(64, activation=\"relu\"),  \n",
    "    ])\n",
    "    if use_dropout:\n",
    "        model.add(layers.Dropout(dropout_rate))\n",
    "    model.add(layers.Dense(num_classes, activation=\"softmax\"))\n",
    "    model.compile(\n",
    "        optimizer=\"adam\",\n",
    "        loss=\"sparse_categorical_crossentropy\",\n",
    "        metrics=[\"accuracy\"],\n",
    "    )\n",
    "    return model\n",
    "\n",
    "def fit_model(built_model, x_train, y_train, epochs, batch_size, x_val, y_val):\n",
    "    return built_model.fit(\n",
    "        x_train, y_train,\n",
    "        epochs=epochs,\n",
    "        batch_size=batch_size,\n",
    "        validation_data=(x_val, y_val),\n",
    "        verbose=1,\n",
    "    )\n",
    "\n",
    "def evaluate_model(built_model, x_test, y_test):\n",
    "    return built_model.evaluate(x_test, y_test, verbose=0)\n",
    "    "
   ]
  },
