   "cell_type": "markdown",
   "id": "bbd6adad",
   "metadata": {},
   "source": [
    "### Methods"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 153,
   "id": "f188b39e",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Logging for lr plot\n",
    "class LRLOGGER(Callback):\n",
    "    def on_train_begin(self, logs=None):\n",
    "        self.lrs = []\n",
    "    def on_epoch_end(self, epoch, logs=None):\n",
    "        lr = self.model.optimizer.learning_rate\n",
    "        try:\n",
    "            self.lrs.append(float(lr))\n",
    "        except TypeError:\n",
    "            self.lrs.append(float(lr.numpy()))\n",
    "\n",
    "# Padding sequences\n",
    "def pad_x(x):\n",
    "    return pad_sequences(x, MAX_LEN)\n",
    "\n",
    "# Validation split\n",
    "def validation_split(x_train, y_train, size=MAX_FEATURES):\n",
    "    \"\"\"Returns: x_val, y_val, x_train, y_train\"\"\"\n",
    "    return x_train[:size], y_train[:size], x_train[size:], y_train[size:]\n",
    "\n",
    "def build_model(is_base=True):\n",
    "    model = Sequential([\n",
    "        layers.Embedding(MAX_FEATURES, 32, name=\"embedding_layer\"),\n",
    "        layers.GlobalAveragePooling1D(name=\"average_pooling\"),\n",
    "        layers.Dense(16, activation='relu', name='relu_1') # Changed layer from 32 to 16 to 8 improving val accuracy\n",
    "    ])\n",
    "    if not is_base:\n",
    "        model.add(layers.Dropout(DROPOUT_RATE, name='dropout_2'))\n",
    "    model.add(layers.Dense(1, activation='sigmoid', name='sigmoid_output'))\n",
    "    return compile_model(model)\n",
    "    \n",
    "def compile_model(model):\n",
    "    model.compile(\n",
    "        optimizer='adam', \n",
    "        loss='binary_crossentropy',\n",
    "        metrics=['accuracy']\n",
    "    )\n",
    "    return model\n",
    "    \n",
    "        \n",
    "def initialise_callbacks(is_lr):\n",
    "    callbacks = [early_stopping()]\n",
    "    lr_logger = None\n",
    "    if is_lr:\n",
    "        lr_logger = LRLOGGER()\n",
    "        callbacks.append(reduce_lr())\n",
    "        callbacks.append(lr_logger)\n",
    "    return callbacks, lr_logger\n",
    "        \n",
    "\n",
    "def early_stopping():\n",
    "    return EarlyStopping(\n",
    "        monitor='val_loss',\n",
    "        patience=5,\n",
    "        restore_best_weights=True\n",
    "    )\n",
    "    \n",
    "def reduce_lr():\n",
    "    return ReduceLROnPlateau(\n",
    "        monitor='val_loss',\n",
    "        factor=0.5,\n",
    "        patience=1,\n",
    "        min_lr=1e-6,\n",
    "        verbose=1\n",
    "    )\n",
    "\n",
    "def fit_model(model, x_train, y_train, x_val, y_val, is_base=True, is_lr=False):\n",
    "    lr_logger = None\n",
    "# Fit the baseline model\n",
    "    if is_base:\n",
    "        history = model.fit(\n",
    "            x_train,\n",
    "            y_train,\n",
    "            epochs=EPOCHS,\n",
    "            batch_size=BATCH_SIZE,\n",
    "            validation_data=(x_val, y_val),\n",
    "            verbose=1       \n",
    "        )\n",
    "    else:\n",
    "        callbacks, lr_logger = initialise_callbacks(is_lr)\n",
    "        history = model.fit(\n",
    "            x_train,\n",
    "            y_train,\n",
    "            epochs=EPOCHS,\n",
    "            batch_size=BATCH_SIZE,\n",
    "            validation_data=(x_val, y_val),\n",
    "            callbacks=callbacks,\n",
    "            verbose=1       \n",
    "        )\n",
    "    return history, lr_logger\n",
    "    \n",
    "# Get best validation accuracy\n",
    "def best_validation(history):\n",
    "    return max(history.history[\"val_accuracy\"])\n",
    "\n",
    "def best_model(baseline_acc, improved_acc, lr_improved_acc):\n",
    "    print(f\"Baseline acc: {baseline_acc} Improved acc: {improved_acc}  lr acc: {lr_improved_acc}\")\n",
    "    if baseline_acc > improved_acc and baseline_acc > lr_improved_acc:\n",
    "        print(\"Baseline model is best\")\n",
    "        return baseline\n",
    "    elif improved_acc > baseline_acc and improved_acc > lr_improved_acc:\n",
    "        print(\"Improved model is best\")\n",
    "        return improved\n",
    "    else:\n",
    "        print(\"Learning Rate Improved model is best\")\n",
    "        return lr\n",
    "    \n",
    "def evaluate_model(model):\n",
    "    _, test_acc = model.evaluate(x_test, y_test, verbose=0)\n",
    "    print(f\"Final test accuracy of best model {test_acc}\")\n",
    "    \n",
    "def plot_lr(lr_logger):\n",
    "    if lr_logger is None or not lr_logger.lrs:\n",
    "        print(\"No learning rate available\")\n",
    "        return\n",
    "    plt.plot(lr_logger.lrs)\n",
    "    plt.xlabel(\"Epoch\")\n",
    "    plt.xticks(range(1, len(lr_logger.lrs) + 1))\n",
    "    plt.ylabel(\"Learning Rate\")\n",
    "    plt.title(\"LR Schedule\")\n",
    "    plt.show()\n",
    "    \n",
    "    "
   ]
